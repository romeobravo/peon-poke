#!/bin/sh
# peon-poke-setup (compatibility shim) — install logic lives in the Python
# CLI: `peon-poke setup`. Kept as an entry point for install.sh,
# install-remote.sh, the Homebrew formula, and muscle memory. Source dir
# defaults to this script's location; override with PEON_POKE_SRC.
DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -x "$DIR/peon-poke" ]; then
  exec "$DIR/peon-poke" setup "$@"
fi
exec "${POKE_DIR:-$HOME/.peon-poke}/bin/peon-poke" setup "$@"
