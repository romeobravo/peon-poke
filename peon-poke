#!/usr/bin/env python3
# peon-poke — control-plane CLI: event dispatch, integrations setup/uninstall,
# and diagnostics. The haptic core stays the C binary (bin/poke); this file
# owns everything the bash scripts used to do.
#
# Subcommands:
#   peon-poke dispatch <category|pattern>   map an agent event to a haptic pattern
#   peon-poke play <pattern>               fire a pattern now (alias of dispatch)
#   peon-poke codex|gemini|cursor|grok     agent event adapters (argv/stdin JSON)
#   peon-poke setup                        install runtime + register hooks
#   peon-poke uninstall [--purge]          remove registrations + installed files
#   peon-poke doctor                       installation/config health report
#
# Environment (unchanged from the bash era):
#   POKE_DIR       install dir            (default ~/.peon-poke)
#   POKE_BIN       haptic binary override (default $POKE_DIR/bin/poke)
#   POKE_CONFIG    config override        (default XDG or ~/.peon-poke fallback)
#   PEON_POKE_SRC  setup source dir       (default: dir of this file)
#   POKE_QUIET / POKE_PATTERN             consumed by bin/poke itself
#
# Python 3.8+, stdlib only. tomllib (3.11+) is used opportunistically to
# parse-validate TOML edits; without it the well-tested structural editor
# still applies. Dispatch paths ALWAYS exit 0 — a hook must never fail or
# block the host agent.
import argparse
import contextlib
import filecmp
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import uuid

CATEGORIES = ("session.start", "task.acknowledge", "task.complete",
              "task.error", "input.required")

# Bumped by scripts/release.sh alongside the VERSION file; used when no
# VERSION file sits next to this copy (the installed CLI).
__version__ = "0.9.0"

UUID_RE = re.compile(r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-'
                     r'[0-9a-f]{4}-[0-9a-f]{12}$')

try:
    import tomllib  # Python 3.11+
except ImportError:
    tomllib = None


# ---------------------------------------------------------------- paths ---

def install_dir():
    return os.environ.get("POKE_DIR") or os.path.expanduser("~/.peon-poke")


def config_dir():
    xdg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(xdg, "peon-poke")


def config_path():
    if os.environ.get("POKE_CONFIG"):
        return os.environ["POKE_CONFIG"]
    p = os.path.join(config_dir(), "config.json")
    if os.path.isfile(p):
        return p
    return os.path.join(install_dir(), "config.json")


def poke_bin():
    return os.environ.get("POKE_BIN") or os.path.join(install_dir(), "bin", "poke")


def self_path():
    return os.path.realpath(__file__)


def src_dir():
    return os.environ.get("PEON_POKE_SRC") or os.path.dirname(self_path())


BOLD, GREEN, YELLOW, RESET = "\033[1m", "\033[32m", "\033[33m", "\033[0m"


def info(msg):
    print("%s>%s %s" % (GREEN, RESET, msg))


def warn(msg):
    print("%s!%s %s" % (YELLOW, RESET, msg), file=sys.stderr)


# ------------------------------------------------------------- dispatch ---

def load_config():
    try:
        with open(config_path()) as f:
            cfg = json.load(f)
        return cfg if isinstance(cfg, dict) else None
    except Exception:
        return None


def resolve_token(cfg, token):
    """Resolve a category/pattern token against the config.

    Returns (pattern, strength) or None when nothing should fire.
    - category mode (token in categories/patterns): gated by categories map
    - pattern mode (anything else): explicit name or raw gap list, ungated
    custom names override built-in names in both modes.
    """
    if not cfg.get("enabled", True):
        return None

    def sect(key):  # hand-edited configs can carry wrong shapes — never crash
        v = cfg.get(key)
        return v if isinstance(v, dict) else {}

    custom = sect("custom")
    categories, patterns = sect("categories"), sect("patterns")
    if token in categories or token in patterns:
        if not categories.get(token, False):
            return None
        pat = patterns.get(token, "")
        pat = custom.get(pat, pat)
    else:
        pat = custom.get(token, token)
    if not pat:
        return None
    return pat, cfg.get("strength", 6)


def fire(pattern, strength):
    """Spawn the haptic binary detached and quiet. Never raises."""
    env = dict(os.environ, POKE_QUIET="1", POKE_PATTERN=str(strength))
    try:
        subprocess.Popen(
            [poke_bin(), pattern],
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        pass  # a missed poke must never fail the host agent


def dispatch_token(token):
    if not token:
        return
    try:
        cfg = load_config()
        if cfg is None:
            return
        resolved = resolve_token(cfg, token)
        if resolved:
            fire(*resolved)
    except Exception:
        pass  # invariant: a broken config must never fail the host agent


def cmd_dispatch(args):
    dispatch_token(getattr(args, "token", None))
    return 0


# ------------------------------------------------------- event adapters ---
# Codex invokes its `notify` program with ONE argument: a JSON object whose
# "type" field names the event. Hook-style callers pass JSON on stdin with a
# "hook_event_name" field; Grok uses camelCase "hookEventName". Very old
# Codex builds passed the bare event name as argv. Case and -/_ separators
# are squashed so all spellings match.

def normalize_event(raw):
    try:
        obj = json.loads(raw)
        if isinstance(obj, dict):
            raw = (obj.get("type") or obj.get("hook_event_name")
                   or obj.get("hookEventName") or "")
    except Exception:
        pass
    return re.sub(r"[-_]", "", str(raw).strip().lower())


CODEX_EVENTS = {
    "agentturncomplete": "task.complete", "stop": "task.complete",
    "turnend": "task.complete",
    "error": "task.error",
    "permission": "input.required", "approvalrequired": "input.required",
    "sessionstart": "session.start", "sessionconfigured": "session.start",
}
GEMINI_EVENTS = {
    "stop": "task.complete", "turncomplete": "task.complete",
    "error": "task.error",
    "notification": "input.required",
    "sessionstart": "session.start",
}
CURSOR_EVENTS = {
    "stop": "task.complete",
    "beforesubmitprompt": "task.acknowledge", "beforeshellexecution": "task.acknowledge",
    # beforeReadFile / beforeMCPExecution / afterFileEdit: too noisy — silent
}
GROK_EVENTS = {
    "stop": "task.complete",
    "error": "task.error",
    "notification": "input.required",
    "sessionstart": "session.start",
}


def run_event_adapter(table, argv_event, read_stdin):
    raw = argv_event or ""
    if not raw and read_stdin and not sys.stdin.isatty():
        try:
            raw = sys.stdin.read()
        except Exception:
            pass
    category = table.get(normalize_event(raw))
    if category:
        dispatch_token(category)
    return 0


# -------------------------------------------------------- shared fs glue ---

def atomic_write(path, content):
    """Write bytes/str atomically (temp file in the same dir + os.replace)."""
    data = content.encode() if isinstance(content, str) else content
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".",
                               prefix="." + os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)


def stable_backup(path):
    """One stable .peon-poke-bak of the ORIGINAL file: never overwritten on
    re-runs (the user's true rollback point), never written through a
    symlink. Delete the .bak to take a fresh one."""
    bak = path + ".peon-poke-bak"
    if (os.path.exists(path) or os.path.islink(path)) \
            and not os.path.exists(bak) and not os.path.islink(bak):
        shutil.copy2(path, bak)
        return True
    return False


def first_bytes_contains(path, needle, lines=8):
    try:
        with open(path, errors="replace") as f:
            head = "".join(f.readline() for _ in range(lines))
    except OSError:
        return False
    return needle in head


def marker_ok(path, kind):
    """The ONLY authorization for destructive removal: a marker file written
    by setup for exactly this directory kind, carrying a well-formed random
    install identity. Name/shape/contents of the directory never authorize
    anything."""
    if not (os.path.isfile(path) and os.access(path, os.R_OK)):
        return False
    app_ok = kind_ok = False
    ident = ""
    try:
        with open(path) as f:
            for line in f:
                line = line.rstrip("\n")
                if line == "app=peon-poke":
                    app_ok = True
                elif line == "kind=%s" % kind:
                    kind_ok = True
                elif line.startswith("install_id="):
                    ident = line[len("install_id="):]
    except OSError:
        return False
    return app_ok and kind_ok and bool(UUID_RE.match(ident))


def stamp_marker(directory, name, kind, version):
    """Write (or refresh, keeping any existing valid identity) the ownership
    marker for one managed directory. The identity is stable across re-runs
    so upgrades keep proving ownership."""
    os.makedirs(directory, exist_ok=True)
    path = os.path.join(directory, name)
    existing = ""
    if os.path.isfile(path):
        try:
            with open(path) as f:
                for line in f:
                    if line.startswith("install_id="):
                        existing = line[len("install_id="):].strip()
                        break
        except OSError:
            pass
    ident = existing if UUID_RE.match(existing or "") else str(uuid.uuid4())
    atomic_write(path, "app=peon-poke\nkind=%s\ninstall_id=%s\nversion=%s\n"
                % (kind, ident, version))


# --------------------------------------------------------- Claude hooks ---
# Exact ownership: an entry is ours only if it is precisely the hook shape
# this setup writes. A user's own hook that merely mentions "peon-poke"
# must be neither skipped on registration nor deleted on uninstall.

CLAUDE_EVENTS = (("Stop", "task.complete"),
                 ("Notification", "input.required"),
                 ("SessionStart", "session.start"))


def claude_hook_patterns():
    cats = "|".join(re.escape(c) for c in CATEGORIES)
    return re.compile(r'^(?:"[^"]*?/bin/peon-poke"|\'[^\']*?/bin/peon-poke\'|\S+/bin/peon-poke)'
                      r' dispatch (?:%s)$' % cats)


def is_our_hook_entry(entry, pattern):
    try:
        if not isinstance(entry, dict) or entry.get("matcher") != "":
            return False
        hs = entry.get("hooks")
        if not (isinstance(hs, list) and len(hs) == 1 and isinstance(hs[0], dict)):
            return False
        if hs[0].get("type") != "command":
            return False
        cmd = hs[0].get("command")
        return isinstance(cmd, str) and bool(pattern.match(cmd))
    except Exception:
        return False


def claude_settings_path():
    return os.path.expanduser("~/.claude/settings.json")


def register_claude(install):
    """Register our hooks idempotently. Returns True on
    success; on any structural problem the file is left byte-identical."""
    path = claude_settings_path()
    if os.path.islink(path):
        # Never write through a symlink: it would silently modify whatever
        # the user pointed it at, which is not ours to touch.
        warn("%s is a symlink — file left untouched" % path)
        return False
    cfg = {}
    if os.path.exists(path):
        try:
            with open(path) as f:
                cfg = json.load(f)
        except Exception as e:
            warn("cannot parse %s (%s) — file left untouched" % (path, e))
            return False
        if not isinstance(cfg, dict):
            warn("%s: top level is not a JSON object — file left untouched" % path)
            return False
    hooks = cfg.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        warn("%s: 'hooks' is not an object — file left untouched" % path)
        return False

    pattern = claude_hook_patterns()
    cli = os.path.join(install, "bin", "peon-poke")
    changed = False
    for event, category in CLAUDE_EVENTS:
        entries = hooks.get(event)
        if not isinstance(entries, list):
            entries = []
        kept = [e for e in entries
                if not is_our_hook_entry(e, pattern)]
        final = kept + [{"matcher": "", "hooks": [{"type": "command",
                     "command": shlex.join([cli, "dispatch", category])}]}]
        if final != entries:
            hooks[event] = final
            changed = True

    if not changed and os.path.exists(path):
        return True  # already in the desired state — no churn, no backup
    if os.path.exists(path):
        stable_backup(path)
    atomic_write(path, json.dumps(cfg, indent=2) + "\n")
    return True


def unregister_claude():
    """Remove exactly our hook entries. Returns
    0 removed, >0 removed (file rewritten), or -1 when untouched on error."""
    path = claude_settings_path()
    if not os.path.isfile(path):
        return 0
    try:
        with open(path) as f:
            cfg = json.load(f)
    except Exception:
        warn("peon-poke: cannot parse %s — left untouched" % path)
        return -1
    if not isinstance(cfg, dict):
        warn("peon-poke: %s: not a JSON object — left untouched" % path)
        return -1
    hooks = cfg.get("hooks")
    if not isinstance(hooks, dict):
        return 0
    pattern = claude_hook_patterns()
    removed = 0
    for event, entries in list(hooks.items()):
        if not isinstance(entries, list):
            continue
        kept = [e for e in entries if not is_our_hook_entry(e, pattern)]
        removed += len(entries) - len(kept)
        if kept:
            hooks[event] = kept
        else:
            del hooks[event]
    if not removed:
        return 0
    stable_backup(path)
    atomic_write(path, json.dumps(cfg, indent=2) + "\n")
    return removed


# ----------------------------------------------------------- Codex TOML ---
# Surgical line editor for ~/.codex/config.toml: we own a notify assignment
# only when its comment-stripped body is structurally `notify = [...]` AND
# its value points at our CLI (current or default install dir). A user's
# own top-level notify always wins; edits are parse-validated when
# tomllib is available.

CODEX_MARKER = "# peon-poke (managed — remove to uninstall)"


def codex_toml_path():
    return os.path.expanduser("~/.codex/config.toml")


def codex_owned_escapes(install=None):
    """JSON-escaped (TOML-basic-string-compatible) paths whose presence in a
    notify body marks the line as ours."""
    dirs = [install_dir()] if install is None else [install]
    dirs.append(os.path.expanduser("~/.peon-poke"))
    return [json.dumps(os.path.join(d, "bin", "peon-poke"))[1:-1] for d in dirs]


def codex_notify_line(install):
    esc = json.dumps(os.path.join(install, "bin", "peon-poke"))[1:-1]
    return 'notify = ["%s", "codex"]' % esc


def is_our_notify(line, escapes):
    body = line.split("#", 1)[0]
    if not re.match(r"^\s*notify\s*=\s*\[", body):
        return False
    return any(e in body for e in escapes)


def toml_parse_ok(text):
    """Parse-validate TOML. With tomllib in this interpreter, directly;
    otherwise ask a 3.11+ python3 if one is on PATH (validation only —
    the edit logic itself never leaves this process). With no validator
    available, structural edits proceed as they always did pre-3.11."""
    if not text.strip():
        return True
    if tomllib is not None:
        try:
            tomllib.loads(text)
            return True
        except Exception:
            return False
    for exe in ("python3.13", "python3.12", "python3.11"):
        p = shutil.which(exe)
        if not p:
            continue
        try:
            r = subprocess.run(
                [p, "-c", "import sys, tomllib; tomllib.loads(sys.stdin.buffer.read().decode())"],
                input=text.encode(), stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL, timeout=10)
            return r.returncode == 0
        except Exception:
            continue
    return True


def codex_strip_managed(lines, escapes):
    """Strip every managed line we ever wrote (marker+notify pair or bare
    managed notify), plus one adjacent separator blank per seam, so
    re-registration lands in exactly one well-formed place."""
    out, seams, i = [], [], 0
    while i < len(lines):
        if lines[i].strip() == CODEX_MARKER and i + 1 < len(lines) \
                and is_our_notify(lines[i + 1], escapes):
            seams.append(len(out))
            i += 2
            continue
        if is_our_notify(lines[i], escapes):
            seams.append(len(out))
            i += 1
            continue
        out.append(lines[i])
        i += 1
    for s in sorted(set(seams), reverse=True):
        if 0 < s <= len(out) and out[s - 1].strip() == "":
            del out[s - 1]
        elif s < len(out) and out[s].strip() == "":
            del out[s]
    return out


def codex_first_table(lines):
    return next((i for i, l in enumerate(lines) if re.match(r"^\s*\[", l)), None)


def register_codex(install):
    """Returns 0 registered/ok, 2 user-notify preserved (our strays removed),
    3 file not valid TOML (untouched), 4 edit would break TOML (untouched)."""
    path = codex_toml_path()
    escapes = codex_owned_escapes(install)
    try:
        with open(path) as f:
            src = f.read()
    except FileNotFoundError:
        src = ""
    except OSError as e:
        warn("cannot read %s (%s) — file left untouched" % (path, e))
        return 3

    lines = src.splitlines()
    base = codex_strip_managed(lines, escapes)
    ft = codex_first_table(base)

    if src and not toml_parse_ok(src):
        warn("~/.codex/config.toml is not valid TOML — file left untouched,"
             " fix it and re-run peon-poke setup")
        return 3

    user_notify = any(re.match(r"^\s*notify\s*=", l)
                      for l in base[:ft if ft is not None else len(base)])

    if user_notify:
        new = "\n".join(base)
        if not new.endswith("\n"):
            new += "\n"
        status = 2
    else:
        block = [CODEX_MARKER, codex_notify_line(install)]
        if ft is None:
            out = list(base)
            if out and out[-1].strip() != "":
                out.append("")
            out += block
        else:
            out = list(base[:ft])
            while out and out[-1].strip() == "":
                out.pop()
            out += [""] + block + [""] + list(base[ft:])
        new = "\n".join(out) + "\n"
        status = 0

    if new == src:
        return status  # already in the desired state — byte-identical, no churn
    if not toml_parse_ok(new):
        warn("refusing to write %s: edit would break TOML" % path)
        return 4
    if src:
        stable_backup(path)
    atomic_write(path, new)
    return status


def unregister_codex(install=None):
    """Remove only the managed notify lines we added. Returns count of
    managed lines removed, or -1 when the file was left untouched."""
    path = codex_toml_path()
    if not os.path.isfile(path):
        return 0
    escapes = codex_owned_escapes(install)
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except OSError as e:
        warn("peon-poke: cannot read %s (%s) — left untouched" % (path, e))
        return -1

    out = codex_strip_managed(lines, escapes)
    removed = len(lines) - len(out)
    if not removed:
        if any("peon-poke" in l for l in lines):
            warn("peon-poke: mentions of peon-poke found in %s but no"
                       " managed notify — file left untouched" % path)
        return -1

    while out and out[-1].strip() == "":
        out.pop()
    new = "\n".join(out) + ("\n" if out else "")
    if not toml_parse_ok(new):
        warn("peon-poke: refusing to rewrite %s: edit would break TOML"
                   % path)
        return -1
    stable_backup(path)
    atomic_write(path, new)
    return removed


