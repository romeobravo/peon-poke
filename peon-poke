MANUAL_AGENTS = {
    "gemini": ("Gemini CLI", "~/.gemini/settings.json", (
        'point hooks at: ~/.peon-poke/adapters/gemini.sh <Event>',
        'events (argv): SessionStart Stop TurnComplete Error Notification',)),
    "grok": ("Grok Build", "~/.grok/hooks/peon-poke.json", (
