        '    "command": "bash ~/.peon-poke/adapters/cursor.sh stop" }] }',)),
}
MANUAL_DIRS = {"gemini": "~/.gemini", "grok": "~/.grok", "cursor": "~/.cursor"}


def plugin_is_ours(path):
    return any(first_bytes_contains(path, m) for m in PLUGIN_MARKERS)


def install_owned_file(src, dest):
    """Never clobbers a foreign file; keeps one stable .peon-poke-bak of a
    user-modified copy of ours before refreshing; never follows/replace a
    symlink."""
    if os.path.exists(dest) or os.path.islink(dest):
        if os.path.islink(dest):
            warn("%s is a symlink — left untouched (remove it to let peon-poke"
                 " manage this path)" % dest)
            return
        if not os.path.isfile(dest):
            warn("%s exists but is not a regular file — skipping" % dest)
            return
        if not plugin_is_ours(dest):
            warn("%s exists but is not recognized as ours — left untouched" % dest)
            return
        if not filecmp.cmp(dest, src, shallow=False) and stable_backup(dest):
            info("Existing file saved to %s.peon-poke-bak (modified copy preserved)" % dest)
    shutil.copy2(src, dest)
    info("Installed: %s" % dest)


def uninstall_plugin(path):
    """If setup preserved a user-customized copy in .peon-poke-bak, restore
    the user's version instead of deleting it — their edits are theirs."""
    if not os.path.isfile(path):
        return
    if not plugin_is_ours(path):
        warn("peon-poke: %s is not recognized as ours — left untouched" % path)
        return
    if os.path.isfile(path + ".peon-poke-bak"):
        os.replace(path + ".peon-poke-bak", path)
        info("Restored user-modified %s (from .peon-poke-bak)" % path)
    else:
        os.remove(path)
        info("Removed %s" % path)


# ------------------------------------------------------------ PATH links ---
# We expose commands only via dirs already on PATH and writable; we never
# create PATH entries or touch shell profiles. Both command names point at
# the one CLI file — the uninstall subcommand is chosen by argv[0] basename.

LINK_CANDIDATE_DIRS = (os.path.expanduser("~/.local/bin"),
                       os.path.expanduser("~/bin"),
                       "/usr/local/bin")


def path_link_targets(install):
    return {"peon-poke": os.path.join(install, "bin", "peon-poke")}


def install_path_links(install):
    want = path_link_targets(install)
    for d in LINK_CANDIDATE_DIRS:
        if d.rstrip("/") not in os.environ.get("PATH", "").split(os.pathsep):
            continue
        if not (os.path.isdir(d) and os.access(d, os.W_OK)):
            continue
        acted = False
        for name, target in want.items():
            link = os.path.join(d, name)
            if os.path.lexists(link):
                if not os.path.islink(link):
                    warn("%s exists and is not ours — not replacing it" % link)
                    continue
                current = os.readlink(link)
                if current == target:
                    acted = True  # this dir already owns the commands — stop here
                    continue
                warn("%s exists and is not ours — not replacing it" % link)
                continue
            with contextlib.suppress(OSError):
                os.unlink(link)
            try:
                os.symlink(target, link)
            except OSError as e:
                warn("could not install %s (%s)" % (link, e))
                continue
            info("Command installed: %s" % link)
            acted = True
        if acted:
            break


def uninstall_path_links(install):
    want = path_link_targets(install)
    for d in LINK_CANDIDATE_DIRS:
        for name, target in want.items():
            link = os.path.join(d, name)
            if not os.path.islink(link):
                continue
            try:
                current = os.readlink(link)
            except OSError:
                continue
            if current == target:
                with contextlib.suppress(OSError):
                    os.unlink(link)
                info("Removed %s" % link)


# ---------------------------------------------------------------- setup ---

def print_manual_help(name):
    title, path, lines = MANUAL_AGENTS[name]
    info("%s — manual wiring in %s:" % (title, path))
    for l in lines:
        print("      " + l)


def cmd_setup(args):
    only = getattr(args, "agent", None)  # None = register every detected agent

    def want(name):
        return only is None or only == name

    src = src_dir()
    # `peon-poke setup` run as the installed CLI (…/bin/peon-poke): the
    # payload is already laid out one level up — heal registrations in
    # place instead of demanding a repo checkout next to the binary.
    installed_layout = os.path.basename(src) == "bin" and all(
        os.path.isfile(os.path.join(os.path.dirname(src), f))
        for f in ("bin/poke", "bin/peon-poke"))
    if installed_layout:
        src = os.path.dirname(src)
    install = install_dir()
    version = read_version(src)

    for rel in (("bin/poke", "bin/peon-poke") if installed_layout
                else ("bin/poke", "peon-poke")):
        p = os.path.join(src, rel)
        if not (os.path.isfile(p) and os.access(p, os.X_OK)):
            warn("%s not found or not executable — run install.sh or brew first" % p)
            return 1

    info("Installing to %s" % install)
    for sub in ("bin", "adapters", "plugins/pi", "plugins/opencode"):
        os.makedirs(os.path.join(install, sub), exist_ok=True)
    cli_src = "bin/peon-poke" if installed_layout else "peon-poke"
    copies = [
        (os.path.join(src, "bin/poke"), os.path.join(install, "bin/poke")),
        (os.path.join(src, cli_src), os.path.join(install, "bin/peon-poke")),
        (os.path.join(src, "plugins/pi/poke.ts"),
         os.path.join(install, "plugins/pi/poke.ts")),
    ]
    oc_src = os.path.join(src, "plugins/opencode/peon-poke.ts")
    if os.path.isfile(oc_src):
        copies.append((oc_src, os.path.join(install, "plugins/opencode/peon-poke.ts")))
    adapters_src = os.path.join(src, "adapters")
    if os.path.isdir(adapters_src):
        for name in sorted(os.listdir(adapters_src)):
            if name.endswith(".sh"):
                copies.append((os.path.join(adapters_src, name),
                               os.path.join(install, "adapters", name)))
    for s, d in copies:
        if os.path.realpath(s) == os.path.realpath(d):
            continue  # healing from the installed payload itself — already in place
        shutil.copy2(s, d)
        if d.endswith(".sh") or os.path.basename(d) in ("poke", "peon-poke"):
            os.chmod(d, 0o755)

    # --- ownership markers (the ONLY authorization for later removal) ---
    stamp_marker(install, ".peon-poke-install", "install", version)
    stamp_marker(config_dir(), ".peon-poke-config", "config", version)

    # --- config (never overwrite an existing one) ---
    cfg = os.path.join(config_dir(), "config.json")
    src_cfg = os.path.join(src, "config.json")
    if os.path.isfile(cfg):
        info("Config already present at %s (kept)" % cfg)
    elif os.path.isfile(src_cfg):
        os.makedirs(config_dir(), exist_ok=True)
        shutil.copy2(src_cfg, cfg)
        info("Config written to %s" % cfg)
    else:
        warn("No default config at %s — config not written" % src_cfg)

    if only in MANUAL_AGENTS:
        print_manual_help(only)

    # --- Claude Code hooks ---
    if not want("claude"):
        pass
    elif os.path.isdir(os.path.expanduser("~/.claude")):
        if register_claude(install):
            info("Claude Code hooks registered (Stop, Notification, SessionStart)")
        else:
            warn("Claude Code hooks NOT registered — fix ~/.claude/settings.json"
                 " and re-run peon-poke setup")
    else:
        info("Claude Code not detected (~/.claude) — skipping")

    # --- Codex notify ---
    if not want("codex"):
        pass
    elif os.path.isdir(os.path.expanduser("~/.codex")):
        status = register_codex(install)
        if status == 0:
            info("Codex notify registered in ~/.codex/config.toml")
        elif status == 2:
            warn("Codex notify NOT registered — existing top-level notify"
                 " preserved (our stray entries removed if any)")
        elif status == 3:
            warn("Codex notify NOT registered — ~/.codex/config.toml is not valid TOML")
        else:
            warn("Codex notify NOT registered — see stderr above")
    else:
        info("Codex not detected (~/.codex) — skipping")

    # --- pi / oh-my-pi extensions ---
    for name, ext_dir in zip(("pi", "oh-my-pi"), EXT_DIRS):
        if not want(name):
            continue
        if os.path.isdir(ext_dir):
            install_owned_file(os.path.join(install, "plugins/pi/poke.ts"),
                               os.path.join(ext_dir, "peon-poke.ts"))
        else:
            info("%s not detected (%s) — skipping" % (name, ext_dir))

    # --- OpenCode plugin (auto-discovered, no config edits needed) ---
    if want("opencode"):
        if os.path.isdir(os.path.dirname(OC_PLUGIN_DIR)):
            os.makedirs(OC_PLUGIN_DIR, exist_ok=True)
            install_owned_file(os.path.join(install, "plugins/opencode/peon-poke.ts"),
                               os.path.join(OC_PLUGIN_DIR, "peon-poke.ts"))
        else:
            info("OpenCode not detected (%s) — skipping" % OC_PLUGIN_DIR)

    # --- PATH commands (guarded, see install_path_links) ---
    install_path_links(install)

    if only is None:
        for name in MANUAL_AGENTS:
            if os.path.isdir(os.path.expanduser(MANUAL_DIRS[name])):
                print()
                print_manual_help(name)
        rest = [n for n in MANUAL_AGENTS
                if not os.path.isdir(os.path.expanduser(MANUAL_DIRS[n]))]
        if rest:
            print("  Manual adapters (not detected): %s — peon-poke setup <name> for wiring"
                  % ", ".join(rest))

    print()
    info("%speon-poke installed.%s Patterns live in %s" % (BOLD, RESET, cfg))
    print("  Uninstall: peon-poke uninstall [--purge]")
    print("  Test: peon-poke play             # default pattern: fortune")
    print("  Status: peon-poke doctor")
    return 0


# ------------------------------------------------------------ uninstall ---

def safe_rm(directory, marker, kind, what):
    """Guarded removal: refuses /, $HOME, empty and non-canonical paths, and
    anything not stamped with a valid peon-poke ownership marker for that
    directory kind. Override: POKE_UNSAFE_RM=1."""
    directory = (directory or "").rstrip("/") or "/"
    if directory == "/":
        warn("refusing to remove: unsafe target")
        return False
    parent = os.path.dirname(directory)
    if not os.path.isdir(parent):
        warn("refusing to remove '%s': parent directory does not exist" % directory)
        return False
    real = os.path.join(os.path.realpath(parent), os.path.basename(directory))
    home_real = os.path.realpath(os.path.expanduser("~"))
    if real in ("/", home_real):
        warn("refusing to remove '%s' (refuse-list: / and $HOME)" % real)
        return False
    if marker_ok(os.path.join(real, marker), kind):
        shutil.rmtree(real)
        info("Removed %s" % real)
        return True
    if os.environ.get("POKE_UNSAFE_RM") == "1":
        warn("POKE_UNSAFE_RM=1 set: removing '%s' despite failing safety checks" % real)
        shutil.rmtree(real)
        info("Removed %s" % real)
        return True
    warn("refusing to remove '%s': no valid peon-poke %s ownership marker" % (real, what))
    warn("(install predates markers? re-run peon-poke setup — or"
               " POKE_UNSAFE_RM=1 if you are sure)")
    return False


MANUAL_UNINSTALL = {
    "gemini": ("~/.gemini/settings.json",
               "remove the hook entry pointing at ~/.peon-poke/adapters/gemini.sh"),
    "grok": ("~/.grok/hooks/peon-poke.json",
             "delete the file (or remove our entry from it)"),
    "cursor": ("~/.cursor/hooks.json",
               "remove hooks entries whose command mentions ~/.peon-poke/adapters/cursor.sh"),
}


def cmd_uninstall(args):
    only = getattr(args, "agent", None)  # None = remove everything

    def want(name):
        return only is None or only == name

    if only in MANUAL_UNINSTALL:
        path, how = MANUAL_UNINSTALL[only]
        info("%s wiring is manual — in %s: %s" % (only, path, how))
        return 0

    install = install_dir()

    if want("claude"):
        n = unregister_claude()
        if n > 0:
            info("Claude Code hooks removed")
        else:
            warn("No peon-poke hooks found in Claude settings (left untouched)")

    if want("codex"):
        n = unregister_codex(install)
        if n > 0:
            info("Codex notify removed")
        else:
            warn("No managed Codex notify found (left untouched)")

    for name, d in zip(("pi", "oh-my-pi"), EXT_DIRS):
        if want(name):
            uninstall_plugin(os.path.join(d, "peon-poke.ts"))
    if want("opencode"):
        uninstall_plugin(os.path.join(OC_PLUGIN_DIR, "peon-poke.ts"))

    if only is not None:
        info("Only %s was unregistered — runtime and other agents kept" % only)
        return 0

    uninstall_path_links(install)

    ok = safe_rm(install, ".peon-poke-install", "install", "runtime")
    if getattr(args, "purge", False):
        ok = safe_rm(config_dir(), ".peon-poke-config", "config", "configuration") and ok
    else:
        kept = os.path.join(config_dir(), "config.json")
        info("Kept %s (use --purge to remove)" % kept)
    return 0 if ok else 1


# --------------------------------------------------------------- doctor ---

def cmd_doctor(_args):
    def line(okay, label, detail):
        print("  %s %s: %s" % ({True: "✓", False: "✗", None: "·"}[okay], label, detail))
        return okay is False

    problems = []
    print("peon-poke doctor")
    v = sys.version_info
    problems.append(line(v >= (3, 8), "python",
                         "%d.%d.%d (%s)" % (v[0], v[1], v[2], sys.executable)
                         + ("" if v >= (3, 8) else " — 3.8+ required")))

    install = install_dir()
    problems.append(line(os.path.isdir(install), "install dir", install))

    binary = poke_bin()
    binary_ok = os.path.isfile(binary) and os.access(binary, os.X_OK)
    problems.append(line(binary_ok, "poke binary", binary))

    cfgp = config_path()
    cfg = load_config() if os.path.isfile(cfgp) else None
    if cfg is None:
        problems.append(line(False, "config", "%s (missing or unparseable)" % cfgp))
    else:
        cats = cfg.get("categories", {})
        on = [c for c, v in cats.items() if v]
        problems.append(line(True, "config",
                             "%s — %d/%d categories on, %s" %
                             (cfgp, len(on), len(cats),
                              "enabled" if cfg.get("enabled", True) else "DISABLED")))

    sp = claude_settings_path()
    if os.path.isfile(sp):
        try:
            with open(sp) as f:
                hooks = (json.load(f) or {}).get("hooks", {})
            pattern = claude_hook_patterns()
            ours = sum(1 for entries in hooks.values() if isinstance(entries, list)
                       for e in entries if is_our_hook_entry(e, pattern))
            problems.append(line(ours > 0, "claude code",
                                 "%d hook(s) registered" % ours if ours
                                 else "no peon-poke hooks in %s" % sp))
        except Exception:
            problems.append(line(False, "claude code", "cannot parse %s" % sp))
    else:
        line(None, "claude code", "not detected")

    tp = codex_toml_path()
    if os.path.isfile(tp):
        try:
            with open(tp) as f:
                ours = any(is_our_notify(l, codex_owned_escapes()) for l in f)
            problems.append(line(ours, "codex", "notify registered" if ours
                                 else "no managed notify in %s" % tp))
        except OSError:
            problems.append(line(False, "codex", "cannot read %s" % tp))
    else:
        line(None, "codex", "not detected")

    for d in EXT_DIRS:
        name = os.path.basename(os.path.dirname(os.path.dirname(d)))
        p = os.path.join(d, "peon-poke.ts")
        if os.path.isdir(d):
            problems.append(line(os.path.isfile(p), name,
                                 "extension installed" if os.path.isfile(p)
                                 else "extension dir present, %s missing" % p))
        else:
            line(None, name, "not detected")
    ocp = os.path.join(OC_PLUGIN_DIR, "peon-poke.ts")
    if os.path.isdir(os.path.dirname(OC_PLUGIN_DIR)):
        problems.append(line(os.path.isfile(ocp), "opencode",
                             "plugin installed" if os.path.isfile(ocp)
                             else "plugin dir present, %s missing" % ocp))
    else:
        line(None, "opencode", "not detected")

    targets = path_link_targets(install)
    for name, target in targets.items():
        found = ""
        for d in LINK_CANDIDATE_DIRS:
            link = os.path.join(d, name)
            if os.path.islink(link) and os.readlink(link) == target:
                found = link
                break
        line(None, "command '%s'" % name, found or "not on PATH (optional)")

    if any(problems):
        print("problems found — run the failing step's fix (often: peon-poke setup)")
        return 1
    print("all good")
    return 0


# ----------------------------------------------------------------- main ---

def read_version(src=None):
    try:
        with open(os.path.join(src or os.path.dirname(self_path()), "VERSION")) as f:
            return f.read().strip()
    except OSError:
        return __version__


def build_parser():
    p = argparse.ArgumentParser(
        prog="peon-poke",
        description="Trackpad haptic notifications for AI coding agents.")
    p.add_argument("--version", action="version",
                   version="peon-poke %s" % read_version())
    sub = p.add_subparsers(dest="command")

    d = sub.add_parser("dispatch", help="map an agent event to a haptic pattern")
    d.add_argument("token", nargs="?", help="category or pattern name/gap list")
    d.set_defaults(func=cmd_dispatch)

    d = sub.add_parser("play", help="fire a pattern now (alias of dispatch)")
    d.add_argument("token", nargs="?", default="task.complete",
                   help="pattern name or gap list (default: the task.complete category)")
    d.set_defaults(func=cmd_dispatch)

    for name, help_, fn in (
            ("codex", "OpenAI Codex CLI notify adapter",
             lambda a: run_event_adapter(CODEX_EVENTS, a.event, True)),
            ("gemini", "Gemini CLI hook adapter",
             lambda a: run_event_adapter(GEMINI_EVENTS, a.event, False)),
            ("cursor", "Cursor IDE hook adapter",
             lambda a: run_event_adapter(CURSOR_EVENTS, a.event, False)),
            ("grok", "Grok Build hook adapter",
             lambda a: run_event_adapter(GROK_EVENTS, a.event, True))):
        d = sub.add_parser(name, help=help_)
        d.add_argument("event", nargs="?", help="event name or JSON (else stdin)")
        d.set_defaults(func=fn)

    d = sub.add_parser("setup", help="install runtime and register hooks")
    d.add_argument("agent", nargs="?",
                   choices=("claude", "codex", "pi", "oh-my-pi", "opencode")
                           + tuple(MANUAL_AGENTS),
                   help="register one integration, or print wiring for a"
                        " manual one (default: all detected)")
    d.set_defaults(func=cmd_setup)

    d = sub.add_parser("uninstall", help="remove registrations and installed files")
    d.add_argument("agent", nargs="?",
                   choices=("claude", "codex", "pi", "oh-my-pi", "opencode")
                           + tuple(MANUAL_AGENTS),
                   help="unregister one integration, or explain removal for a"
                        " manual one (default: everything)")
    d.add_argument("--purge", action="store_true",
                   help="also remove ~/.config/peon-poke/config.json")
    d.set_defaults(func=cmd_uninstall)

    d = sub.add_parser("doctor", help="installation and config health report")
    d.set_defaults(func=cmd_doctor)
    return p


def main(argv):
    parser = build_parser()
    args = parser.parse_args(argv[1:])
    if not getattr(args, "func", None):
        parser.print_help()
        return 0
    try:
        return args.func(args) or 0
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
